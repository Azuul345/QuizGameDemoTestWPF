<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="InitialQuizzes\GeneralQuiz.json" />
    <None Remove="InitialQuizzes\GeneralQuizImg\cat.jpg" />
    <None Remove="InitialQuizzes\GeneralQuizImg\sweden.jpg" />
    <None Remove="InitialQuizzes\MathQuiz.json" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="InitialQuizzes\GeneralQuiz.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Content Include="InitialQuizzes\GeneralQuizImg\cat.jpg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="InitialQuizzes\GeneralQuizImg\sweden.jpg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="InitialQuizzes\MathQuiz.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
