<UserControl x:Class="QuizGame.Views.EditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QuizGame.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Pick quiz -->
        <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
            <TextBlock Text="Select quiz:" Margin="0,0,8,0" VerticalAlignment="Center"/>
            <ComboBox x:Name="QuizPicker" Width="300" DisplayMemberPath="Title"
              SelectionChanged="QuizPicker_SelectionChanged"/>
        </StackPanel>

        <!-- Edit form -->
        <StackPanel Grid.Row="1" Grid.Column="0">
            <TextBlock Text="Statement"/>
            <TextBox x:Name="StatementInput"/>

            <TextBlock Text="Answer 1" Margin="0,8,0,0"/>
            <TextBox x:Name="Ans0Input"/>

            <TextBlock Text="Answer 2" Margin="0,8,0,0"/>
            <TextBox x:Name="Ans1Input"/>

            <TextBlock Text="Answer 3" Margin="0,8,0,0"/>
            <TextBox x:Name="Ans2Input"/>

            <TextBlock Text="Correct (1-3)" Margin="0,8,0,0"/>
            <ComboBox x:Name="CorrectPick" Width="80">
                <ComboBoxItem Content="1"/>
                <ComboBoxItem Content="2"/>
                <ComboBoxItem Content="3"/>
            </ComboBox>

            <TextBlock Text="Subject (optional)" Margin="0,8,0,0"/>
            <TextBox x:Name="SubjectInput"/>

            <TextBlock Text="Image URL or file name (optional)" Margin="0,8,0,0"/>
            <TextBox x:Name="ImageInput"/>

            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button Content="Update selected" Width="140" Click="Update_Click"/>
                <Button Content="Delete selected" Width="140" Margin="8,0,0,0" Click="Delete_Click"/>
            </StackPanel>
        </StackPanel>

        <!-- spacer -->
        <Rectangle Grid.Row="1" Grid.Column="1"/>

        <!-- Questions list -->
        <Grid Grid.Row="1" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Questions in this quiz" FontWeight="Bold" Margin="0,0,0,6"/>
            <ListBox x:Name="QuestionsList" Grid.Row="1"
             SelectionChanged="QuestionsList_SelectionChanged"
             ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Statement}" FontWeight="Bold"/>
                            <TextBlock Text="{Binding Answers[0]}"/>
                            <TextBlock Text="{Binding Answers[1]}"/>
                            <TextBlock Text="{Binding Answers[2]}"/>
                            <TextBlock Text="{Binding CorrectAnswer, StringFormat=Correct: {0}}"/>
                            <TextBlock Text="{Binding Subject, StringFormat=Subject: {0}}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- Bottom actions -->
        <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
            <Button Content="Save quiz" Width="140" Click="Save_Click"/>
            <Button Content="Add question" Click="AddQuestion_Click" Margin="8,0,8,0"/>
            <Button Content="Back to menu" Width="140" Margin="8,0,0,0" Click="Back_Click"/>
        </StackPanel>
    </Grid>

</UserControl>
