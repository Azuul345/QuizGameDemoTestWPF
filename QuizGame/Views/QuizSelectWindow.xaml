<UserControl x:Class="QuizGame.Views.QuizSelectWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QuizGame"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="20">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="360">
            <TextBlock Text="Select a quiz" FontSize="24" FontWeight="Bold"
               Margin="0,0,0,12" TextAlignment="Center"/>
            
            
                <TextBlock Text="Subject:" VerticalAlignment="Center" Margin="0,0,8,0"/>

            <ListBox x:Name="SubjectFilter" Width="180" MaxHeight="140" ScrollViewer.VerticalScrollBarVisibility="Auto"
                          SelectionMode="Multiple" Margin="0,0,0,8"/>
            
            
            <ListBox x:Name="QuizList"
             Height="220"
             DisplayMemberPath="Title" />

            <Button Content="Start Quiz"
            Height="35" Margin="0,12,0,0"
            Click="StartQuiz_Click"/>

            <Button Content="Back to Menu"
            Height="32" Margin="0,10,0,0"
            Click="Back_Click"/>
        </StackPanel>
    </Grid>
</UserControl>