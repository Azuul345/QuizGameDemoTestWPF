<UserControl x:Class="QuizGame.Views.QuizSelectWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QuizGame"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="20">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="300">
            <TextBlock Text="Select a Quiz"
                       FontSize="24" FontWeight="Bold"
                       Margin="0,0,0,16" TextAlignment="Center"/>

            <!-- CHANGED: list of available quizzes (strings) -->
            <ListBox x:Name="QuizList" Height="160" Margin="0,0,0,12"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" >
                <Button Content="Play" Width="120" Height="32" Margin="0,0,8,0"
                        Click="Play_Click"/>
                <Button Content="Back" Width="120" Height="32"
                        Click="Back_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>