<UserControl x:Class="QuizGame.Views.ResultsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"  
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QuizGame"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <Grid Margin="20" Width="520" HorizontalAlignment="Center">
        <!-- Row0: header, Row1: scrollable list, Row2: actions -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Score header -->
        <TextBlock Grid.Row="0"
               Text="{Binding ScoreText}"
               FontSize="22" FontWeight="Bold"
               HorizontalAlignment="Center" Margin="0,0,0,12"/>

        <!-- WRONG ANSWERS: fills available space and scrolls -->
        <Border Grid.Row="1" BorderBrush="#DDD" BorderThickness="1" Padding="8">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock Text="Wrong by subject" FontWeight="Bold"/>
                    <ItemsControl ItemsSource="{Binding WrongBySubject}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Key}" Width="180"/>
                                    <TextBlock Text="{Binding Value}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <TextBlock Text="Questions you got wrong"
                   FontWeight="Bold" Margin="0,0,0,8"
                   DockPanel.Dock="Top"/>
                <!-- ListBox scrolls automatically because Row1 is '*' -->
                <ListBox ItemsSource="{Binding WrongAnswers}"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8" Margin="0,0,0,8" BorderBrush="LightGray" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Thumbnail -->
                                    <Image Grid.Column="0"
                         Source="{Binding ImagePath}"
                         MaxWidth="220" MaxHeight="160" Stretch="Uniform">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <Trigger Property="Source" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding ImagePath}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>

                                    <!-- Texts -->
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{Binding Statement}" FontWeight="Bold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding UserAnswer}"  Foreground="IndianRed"  TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding CorrectAnswer}" Foreground="ForestGreen" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Actions -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
            <Button Content="Play again" Width="140" Height="36" Margin="0,0,8,0"
              Click="PlayAgain_Click"/>
            <Button Content="Main menu" Width="140" Height="36"
              Click="Menu_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
